EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only secret for the Google AI Studio API, used by
# app/api/chat+api.ts and app/api/baseline+api.ts. Do NOT prefix with
# EXPO_PUBLIC_ — that prefix inlines a value into the client bundle, and this
# key must only ever be read inside an API route (Node.js server).
AI_STUDIO_API_KEY=

# Google Maps SDK key for react-native-maps (map tile rendering). Read only
# by app.config.js at build time — never referenced from client code — so it
# does NOT need an EXPO_PUBLIC_ prefix. This key type is designed by Google to
# ship inside compiled apps; restrict it in Google Cloud Console to your
# Android package name + SHA-1 fingerprint (and/or iOS bundle ID) rather than
# treating it as a pure secret. Needs "Maps SDK for Android" (and/or iOS)
# enabled.
GOOGLE_MAPS_API_KEY=

# Server-only secret for app/api/directions+api.ts. Do NOT prefix with
# EXPO_PUBLIC_ — only ever read inside that API route. Needs the "Directions
# API" enabled on the same (or a different) Google Cloud project.
GOOGLE_DIRECTIONS_API_KEY=
